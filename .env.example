# Social profile destinations (server-only — never import into the client)
PROFILE_GITHUB=https://github.com/your-username
PROFILE_HH=https://hh.ru/resume/your-resume-id
PROFILE_TELEGRAM=https://t.me/your-username

# External project destinations (server-only)
PROJECT_DOOR_SOFT=https://dveri-soft.com
PROJECT_GOODPAPA=https://goodpapa12.com

# Production server port inside the process / container (Docker Compose forces 3000).
PORT=3000

# Host port published by Docker Compose (docker compose up). Defaults to 3000.
HOST_PORT=3000

# Set to 1 only when the app runs behind a trusted reverse proxy (Nginx/Caddy).
# Leaves rate-limit IP keys resistant to X-Forwarded-For spoofing when unset.
TRUST_PROXY=

# Optional: comma-separated public Host values (e.g. example.com,www.example.com).
# When set, API requests with other Host headers are rejected.
PUBLIC_HOST=

# Canonical public origin. Enables HTTP/www canonical redirects in production.
PUBLIC_ORIGIN=https://antonfedotov.com

# Telegram notifications (server-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Yandex SMTP (server-only)
YANDEX_SMTP_HOST=smtp.yandex.ru
YANDEX_SMTP_PORT=465
YANDEX_SMTP_SECURE=true
YANDEX_EMAIL=fedotov.fortuna@yandex.ru
YANDEX_PASSWORD=
MAIL_TO=fedotov.fortuna@yandex.ru
